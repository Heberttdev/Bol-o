{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['nome', 'email', 'role', 'createdAt']) && newData.child('nome').isString() && newData.child('email').isString() && newData.child('createdAt').isNumber() && (root.child('users').child(auth.uid).child('role').val() == 'admin' || newData.child('role').val() == 'user') && (!data.exists() || root.child('users').child(auth.uid).child('role').val() == 'admin' || newData.child('role').val() == data.child('role').val())",
        "nome": { ".validate": "newData.val().length <= 80" },
        "email": { ".validate": true },
        "role": { ".validate": true },
        "createdAt": { ".validate": true },
        "photoURL": { ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 1000" },
        "fcmToken": { ".validate": "newData.isString() && newData.val().length <= 4096" },
        "fcmTokenUpdatedAt": { ".validate": "newData.isNumber()" },
        "platform": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "$other": { ".validate": false }
      }
    },

    "perfisPublicos": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['nome'])",
        "nome": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "photoURL": { ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 1000" },
        "$other": { ".validate": false }
      }
    },

    "jogos": {
      ".read": "auth != null",
      "$jogoId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
        ".validate": "newData.hasChildren(['id', 'casa', 'fora', 'fase', 'data', 'lockAt']) && newData.child('id').val() == $jogoId && newData.child('casa').isString() && newData.child('fora').isString() && newData.child('fase').isString() && newData.child('data').isString() && newData.child('lockAt').isNumber()"
      }
    },

    "resultados": {
      ".read": "auth != null",
      "$jogoId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
        ".validate": "newData.hasChildren(['casa', 'fora']) && newData.child('casa').isNumber() && newData.child('fora').isNumber() && newData.child('casa').val() >= 0 && newData.child('fora').val() >= 0 && newData.child('casa').val() <= 99 && newData.child('fora').val() <= 99"
      }
    },

    "bets": {
      ".read": "auth != null",
      "$uid": {
        "$jogoId": {
          ".write": "auth != null && auth.uid == $uid && !root.child('resultados').child($jogoId).exists() && root.child('jogos').child($jogoId).child('lockAt').isNumber() && root.child('jogos').child($jogoId).child('lockAt').val() > now",
          ".validate": "newData.hasChildren(['casa', 'fora']) && newData.child('casa').isNumber() && newData.child('fora').isNumber() && newData.child('casa').val() >= 0 && newData.child('fora').val() >= 0 && newData.child('casa').val() <= 99 && newData.child('fora').val() <= 99"
        }
      }
    },

    "notificacoes": {
      ".read": "auth != null",
      "$notifId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
        ".validate": "newData.hasChildren(['titulo', 'corpo', 'createdAt']) && newData.child('titulo').isString() && newData.child('corpo').isString() && newData.child('createdAt').isNumber() && !newData.child('para').exists()"
      }
    },

    "notificacoesUsuario": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        "$notifId": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
          ".validate": "newData.hasChildren(['titulo', 'corpo', 'createdAt']) && newData.child('titulo').isString() && newData.child('corpo').isString() && newData.child('createdAt').isNumber()"
        }
      }
    },

    "boloesEspeciais": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      "$bolaoId": {
        ".read": "auth != null && data.child('participantes').child(auth.uid).exists()",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
        ".validate": "!data.exists() || newData.hasChildren(['nome', 'valorEntrada', 'status', 'jogos', 'participantes'])",
        "respostas": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('boloesEspeciais').child($bolaoId).child('participantes').child($uid).exists()",
            ".validate": "newData.isString() && (newData.val() == 'aceito' || newData.val() == 'recusado')"
          }
        },
        "palpites": {
          "$uid": {
            "$jogoId": {
              ".write": "auth != null && auth.uid == $uid && root.child('boloesEspeciais').child($bolaoId).child('participantes').child($uid).exists() && root.child('boloesEspeciais').child($bolaoId).child('respostas').child($uid).val() == 'aceito' && root.child('boloesEspeciais').child($bolaoId).child('status').val() == 'aberto' && root.child('boloesEspeciais').child($bolaoId).child('jogos').child($jogoId).exists() && !root.child('boloesEspeciais').child($bolaoId).child('resultados').child($jogoId).exists() && (!root.child('boloesEspeciais').child($bolaoId).child('jogos').child($jogoId).child('lockAt').exists() || root.child('boloesEspeciais').child($bolaoId).child('jogos').child($jogoId).child('lockAt').val() > now)",
              ".validate": "newData.hasChildren(['casa', 'fora']) && newData.child('casa').isNumber() && newData.child('fora').isNumber() && newData.child('casa').val() >= 0 && newData.child('fora').val() >= 0 && newData.child('casa').val() <= 99 && newData.child('fora').val() <= 99"
            }
          }
        },
        "resultados": {
          "$jogoId": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
            ".validate": "newData.hasChildren(['casa', 'fora']) && newData.child('casa').isNumber() && newData.child('fora').isNumber() && newData.child('casa').val() >= 0 && newData.child('fora').val() >= 0 && newData.child('casa').val() <= 99 && newData.child('fora').val() <= 99"
          }
        }
      }
    },

    "participantesBolao": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
      }
    }
  }
}
